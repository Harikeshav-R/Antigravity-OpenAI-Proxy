# Google OAuth Client Credentials (required for web /login flow and token refreshes)
# Obtain these from your Google Cloud Console OAuth 2.0 Credentials or Cloud Code setup
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Direct Credentials (alternative to web OAuth login)
# If provided, the proxy can run headlessly without web login
ANTIGRAVITY_REFRESH_TOKEN=
ANTIGRAVITY_PROJECT_ID=
ANTIGRAVITY_ACCESS_TOKEN=

# Proxy Configuration
PORT=8000
CREDENTIALS_PATH=credentials.json
PRIMARY_ENDPOINT=https://daily-cloudcode-pa.googleapis.com
SANDBOX_ENDPOINT=https://daily-cloudcode-pa.sandbox.googleapis.com

# Optional OpenRouter key for LiteLLM load balancer sidecar
OPENROUTER_API_KEY=
